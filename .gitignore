# Temporary local work files
*.bak
*.tmp
*.temp
*.swp
*.swo
tmp/
temp/
scratch/

# Heavy generated DSGE caches. Already tracked files remain tracked; these
# patterns only keep new regenerated caches out of future commits.
dsge/output_data/*/*/estimate/work/
dsge/output_data/*/*/estimate/tables/
dsge/output_data/*/*/forecast/raw/
dsge/output_data/*/*/forecast/work/

# Legacy plotting outputs outside the final paper artifact directories
plot/Figures*/
plot/Tables/Bloomberg_rstar_spreads.xlsx
