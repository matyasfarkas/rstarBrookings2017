# Operating-system and editor noise
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
.vscode/

# Microsoft Office and LibreOffice lock files
~$*
**/~$*
.~lock.*#
**/.~lock.*#

# Julia scratch artifacts
.julia/
*.ji
*.cov
*.mem

# TeX/latexmk intermediate files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Temporary local work files
*.bak
*.tmp
*.temp
*.swp
*.swo
tmp/
temp/
scratch/

# Heavy generated DSGE caches. Already tracked files remain tracked; these
# patterns only keep new regenerated caches out of future commits.
dsge/output_data/*/*/estimate/work/
dsge/output_data/*/*/estimate/tables/
dsge/output_data/*/*/forecast/raw/
dsge/output_data/*/*/forecast/work/

# Legacy plotting outputs outside the final paper artifact directories
plot/Figures*/
plot/Tables/Bloomberg_rstar_spreads.xlsx

# Replication-package pruning
# Keep source scripts, paper-facing outputs, inputs, and DSGE estimate/raw files.
# Ignore inherited or regenerated material that is not needed in the package.
statespace/
plot/
update/
sytem priors/

# Historical scratch/output folders retained locally but not in the package
**/todelete/
**/%OUTDIR%/

# Backup and duplicate working copies
*backup*
*Backup*
* copy*
* Copy*
*.old
*.orig

# Generated DSGE outputs that can be rebuilt from scripts and estimate/raw files
dsge/output_data/*/*/estimate/figures/
dsge/output_data/*/*/forecast/figures/
